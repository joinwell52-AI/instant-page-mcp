{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "工作包字段规范 1.0",
  "description": "验证单独字段目录或完整宿主目录中的字段部分。服务端另行核对字段引用、列表列子集、上下界顺序、真实公历日期，并在提交时执行语义校验。",
  "type": "object",
  "required": ["field_spec_version", "fields", "work_packages"],
  "properties": {
    "field_spec_version": { "const": "1.0" },
    "fields": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/reference" },
      "additionalProperties": { "$ref": "#/$defs/field" }
    },
    "work_packages": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/reference" },
      "additionalProperties": { "$ref": "#/$defs/work_package" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "reference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_一-鿿][A-Za-z0-9_.一-鿿-]{0,127}$"
    },
    "label": { "type": "string", "pattern": "\\S" },
    "reference_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reference" }
    },
    "appearance": {
      "type": "object",
      "properties": {
        "theme": { "enum": ["default", "blue", "mono"], "default": "default" },
        "layout": { "enum": ["stacked", "grid", "wide"], "default": "stacked" },
        "locale": { "enum": ["zh-CN", "en"], "default": "zh-CN" },
        "translations": {
          "type": "object",
          "properties": {
            "title": {
              "type": "object",
              "properties": {
                "zh-CN": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "zh-CN",
                "en"
              ],
              "additionalProperties": false
            },
            "purpose": {
              "type": "object",
              "properties": {
                "zh-CN": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "zh-CN",
                "en"
              ],
              "additionalProperties": false
            },
            "fields": {
              "type": "object",
              "maxProperties": 64,
              "propertyNames": {
                "pattern": "^[A-Za-z0-9_一-鿿][A-Za-z0-9_.一-鿿-]{0,127}$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "zh-CN": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                },
                "required": [
                  "zh-CN",
                  "en"
                ],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S" },
        "required": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "work_package": {
      "type": "object",
      "required": ["label", "parameters"],
      "properties": {
        "label": { "$ref": "#/$defs/label" },
        "parameters": { "$ref": "#/$defs/reference_list" },
        "list_columns": { "$ref": "#/$defs/reference_list" },
        "appearance": { "$ref": "#/$defs/appearance" },
        "attachment": { "$ref": "#/$defs/attachment" }
      },
      "additionalProperties": false
    },
    "calendar_date": {
      "type": "string",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$",
      "format": "date"
    },
    "length_bounds": {
      "properties": {
        "min_length": { "type": "integer", "minimum": 0, "maximum": 10000, "default": 0 },
        "max_length": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 2000 }
      }
    },
    "field": {
      "type": "object",
      "required": ["label", "type"],
      "properties": {
        "label": { "$ref": "#/$defs/label" },
        "required": { "type": "boolean", "default": false }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/length_bounds",
          "properties": {
            "type": { "const": "text" },
            "format": { "enum": ["cn_mobile", "cn_resident_id"] }
          },
          "allOf": [
            {
              "if": { "required": ["format"], "properties": { "format": { "const": "cn_mobile" } } },
              "then": { "properties": { "min_length": { "maximum": 14 }, "max_length": { "minimum": 14 } } }
            },
            {
              "if": { "required": ["format"], "properties": { "format": { "const": "cn_resident_id" } } },
              "then": { "properties": { "min_length": { "maximum": 18 }, "max_length": { "minimum": 18 } } }
            }
          ]
        },
        {
          "$ref": "#/$defs/length_bounds",
          "properties": { "type": { "const": "textarea" } }
        },
        {
          "properties": {
            "type": { "const": "number" },
            "integer": { "type": "boolean", "default": false },
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        {
          "properties": {
            "type": { "const": "date" },
            "min": { "$ref": "#/$defs/calendar_date" },
            "max": { "$ref": "#/$defs/calendar_date" }
          }
        },
        {
          "required": ["options"],
          "properties": {
            "type": { "const": "select" },
            "options": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?(?![\\s\\S])" }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
