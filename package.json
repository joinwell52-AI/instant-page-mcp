{
  "name": "instant-page-mcp",
  "version": "0.4.2",
  "mcpName": "io.github.joinwell52-AI/instant-page-mcp",
  "description": "为数字员工生成登记、查询选择和可编辑核对页，支持提交校验与 MCP 回读。",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "instant-page-mcp": "./bin/mcp.mjs",
    "instant-page-mcp-service": "./bin/service.mjs",
    "instant-page-mcp-demo": "./bin/demo.mjs",
    "instant-page-mcp-managed": "./bin/managed.mjs"
  },
  "scripts": {
    "start": "node src/mcp.mjs",
    "service": "node src/service.mjs",
    "demo": "node bin/demo.mjs",
    "test": "node --test test/mcp.test.mjs test/render.test.mjs test/service.test.mjs test/generic-host.test.mjs test/work-package.test.mjs test/field-contract.test.mjs test/registry-contract.test.mjs test/link-lifetime.test.mjs test/field-feedback.test.mjs test/managed.test.mjs integrations/work-package/adapter.test.mjs integrations/work-package/frozen-asset.test.mjs"
  },
  "files": [
    "README.en.md",
    "bin/",
    "src/",
    "examples/",
    "schemas/",
    "skills/",
    "通用即时页面生成器MCP-开发手册.md",
    "integrations/work-package/*.mjs",
    "integrations/work-package/*.json",
    "!integrations/work-package/*.test.mjs",
    "integrations/weixin/bridge.mjs",
    "integrations/weixin/package.json",
    "integrations/weixin/package-lock.json"
  ],
  "exports": {
    "./service": "./src/service.mjs",
    "./work-package/adapter": "./integrations/work-package/adapter.mjs",
    "./work-package/frozen-asset": "./integrations/work-package/frozen-asset.mjs",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joinwell52-AI/instant-page-mcp.git"
  }
}
